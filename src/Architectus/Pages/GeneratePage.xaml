<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Architectus.Pages.GeneratePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Generate" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource CaptionStyle}"
                       Text="Describe what you want in plain words. Architectus turns it into a structured master prompt you can use in any AI." />
        </StackPanel>

        <InfoBar x:Name="NoKeyBar" Grid.Row="1" Severity="Informational" IsClosable="False"
                 Title="Add an API key to get started"
                 Message="Architectus uses your own OpenAI, Anthropic or Gemini key. It's stored in Windows Credential Manager, never in a file.">
            <InfoBar.ActionButton>
                <Button Content="Open Settings" Click="OpenSettings_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid x:Name="Panes" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="5*" />
                <ColumnDefinition x:Name="RightCol" Width="7*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="*" />
                <RowDefinition x:Name="BottomRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- Input -->
            <Border x:Name="InputCard" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your rough request" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="InputBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="e.g. help me write a cover letter for a barista job, I'm friendly and have 2 years experience"
                             TextChanged="InputBox_TextChanged" />
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ModelLabel" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Ctrl + Enter to generate" />
                        </StackPanel>
                        <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Visibility="Collapsed" Click="Stop_Click" />
                        <Button x:Name="GenerateButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                Click="Generate_Click" IsEnabled="False" MinWidth="120">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="14" />
                                <TextBlock Text="Generate" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Output -->
            <Border x:Name="OutputCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Master prompt" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="OutputBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     IsSpellCheckEnabled="False" MinHeight="200"
                                     PlaceholderText="Your polished prompt will appear here. You can edit it before copying or saving."
                                     TextChanged="OutputBox_TextChanged" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="ClearButton" Click="Clear_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" FontSize="14" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveButton" Click="Save_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Save to library" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock x:Name="CopyText" Text="Copy" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightCol.Width" Value="0" />
                        <Setter Target="LeftCol.Width" Value="*" />
                        <Setter Target="BottomRow.Height" Value="3*" />
                        <Setter Target="TopRow.Height" Value="2*" />
                        <Setter Target="OutputCard.(Grid.Column)" Value="0" />
                        <Setter Target="OutputCard.(Grid.Row)" Value="1" />
                        <Setter Target="Panes.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
