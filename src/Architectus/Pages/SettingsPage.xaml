<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Architectus.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,20,32,40" MaxWidth="860" HorizontalAlignment="Left" Spacing="0">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="AI provider" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Pick which service writes your prompts. Google Gemini has a free tier (no card needed). OpenAI and Anthropic need prepaid credit on your API account, though a prompt usually costs a fraction of a cent." />
                    <RadioButtons x:Name="ProviderChoice" SelectionChanged="ProviderChoice_SelectionChanged" />
                </StackPanel>
            </Border>

            <TextBlock Text="API keys and models" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel x:Name="ProviderCards" Spacing="8" />

            <TextBlock Text="Privacy and security" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Your API keys are stored in " /><Run Text="Windows Credential Manager" FontWeight="SemiBold" /><Run Text=", encrypted by Windows for your user account. They are never written to a settings file, log, or anywhere else, and are only sent to the provider you pick." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Architectus has no servers, accounts, analytics or telemetry. Your requests go straight from this PC to the AI provider. Your library is saved only on this PC." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open Credential Manager" Click="OpenCredMan_Click" />
                        <Button Content="Open data folder" Click="OpenData_Click" />
                        <Button Content="Remove all keys" Click="RemoveAll_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="EditionText" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Free and open source under the MIT License. Made by Opifex Studios." />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                        <HyperlinkButton Content="opifexstudios.ca" NavigateUri="https://opifexstudios.ca" Padding="0" />
                        <HyperlinkButton Content="Privacy policy" NavigateUri="https://opifexstudios.ca/#architectus-privacy" Padding="0" />
                        <HyperlinkButton Content="Source code" NavigateUri="https://github.com/arkbullet2626-droid/Architectus" Padding="0" />
                        <HyperlinkButton Content="Report a problem" NavigateUri="https://github.com/arkbullet2626-droid/Architectus/issues" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
