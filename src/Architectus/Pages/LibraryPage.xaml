<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Architectus.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Architectus.Services">

    <Grid Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Library" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource CaptionStyle}" Text="Prompts you've saved. Stored only on this PC." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search saved prompts"
                                    QueryIcon="Find" TextChanged="Search_TextChanged" />
                    <ListView x:Name="ItemsList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="ItemsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:LibraryItem">
                                <StackPanel Padding="0,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Preview}" Style="{StaticResource CaptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyList" Grid.Row="1" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8F1;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="EmptyListText" HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource CaptionStyle}" Text="Nothing saved yet.&#x0a;Generate a prompt and hit Save to library." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <TextBlock x:Name="NoSelection" Text="Select a prompt to view or edit it."
                               Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid x:Name="Detail" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TitleBox" Header="Title" TextChanged="Detail_Changed" />
                        <Expander Grid.Row="1" Header="Original rough request" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBlock x:Name="RoughText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Expander>
                        <TextBox x:Name="PromptBox" Grid.Row="2" Header="Prompt" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" IsSpellCheckEnabled="False"
                                 TextChanged="Detail_Changed" />
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MetaText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Click="Delete_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveChangesButton" Click="SaveChanges_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="Save changes" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Copy_Click" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock x:Name="CopyText" Text="Copy" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
